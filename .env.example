# Copia este archivo como ".env" y cambia las contraseñas.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Base de datos (usuario administrador de PostgreSQL)
POSTGRES_DB=gestor_tareas
POSTGRES_USER=admin_tareas
POSTGRES_PASSWORD=cambia_esta_clave_admin

# Usuario con permisos mínimos que usa la aplicación
APP_DB_USER=app_tareas
APP_DB_PASSWORD=cambia_esta_clave_app

# Puerto del equipo donde se abre la aplicación (http://localhost:3000)
APP_PORT=3000
